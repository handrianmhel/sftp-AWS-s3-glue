# Copy to terraform.tfvars (gitignored) and adjust as needed.
# cp terraform.tfvars.example terraform.tfvars
#
# Or use env-specific files from the repo root:
# terraform apply -var-file=..\..\env\personal-apse1.tfvars

# aws_region = "ap-southeast-1"
# name_prefix = "sftp-s3-glue-rd"

# personal (create new bucket):
# use_existing_bucket = false
# bucket_name = null
# object_prefixes = ["raw/"]

# Existing bucket (same account/region as deploy credentials):
# use_existing_bucket = true
# bucket_name = "rccglobe-demo-bucket"
# object_prefixes = ["public-folder/", "restricted-folder/"]

# lambda_runtime = "dotnet8"
# lambda_handler = "RdSuccessLogger::RdSuccessLogger.Function::FunctionHandler"
# lambda_architectures = ["x86_64"]
# lambda_timeout = 10
# lambda_memory = 128
# log_retention_days = 7

# enable_bucket_lister = true
# bucket_lister_timeout = 30
# bucket_lister_memory = 256

# enable_sftp = true
# sftp_instance_type = "t3.small"
# sftp_allowed_cidr_blocks = ["203.0.113.10/32"]
# sftp_port = 22
# sftp_use_elastic_ip = true
# sftp_enable_admin_ui_ingress = true
# sftpgo_version = "2.6.6"

# enable_sftp_pull = false
# sftp_pull_schedule = "rate(5 minutes)"
# sftp_pull_remote_path = "/incoming"
# sftp_pull_s3_prefix = "raw/"
# sftp_pull_max_file_bytes = 104857600
# sftp_pull_timeout = 300
# sftp_pull_memory = 512
# sftp_pull_ssm_prefix = ""  # defaults to /${name_prefix}/sftp-pull

# enable_sftp_pull_stub = false
# sftp_pull_allowed_cidr_blocks = ["203.0.113.10/32"]
# sftp_pull_stub_instance_type = "t3.micro"
# sftp_pull_stub_username = "sftp-pull"

