# bucket_name = null
# object_prefixes = ["raw/"]

# Existing bucket (same account/region as deploy credentials):
# use_existing_bucket = true
# bucket_name = "rccglobe-demo-bucket"
# object_prefixes = ["public-folder/", "restricted-folder/"]

