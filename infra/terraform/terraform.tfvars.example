# Copy to terraform.tfvars (gitignored) and adjust as needed.
# cp terraform.tfvars.example terraform.tfvars
#
# Or use env-specific files from the repo root:
# terraform apply -var-file=..\..\env\personal-apse1.tfvars

# aws_region = "ap-southeast-1"
# name_prefix = "sftp-s3-glue-rd"

